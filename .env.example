# YTT Environment Variables Template
# Copy this file to .env and configure for your environment

# Backend Configuration
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Translation Service
# Option 1: Use Docker LibreTranslate service (default)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Option 2: Use external LibreTranslate instance
# LIBRETRANSLATE_URL=https://translate.your-domain.com

# Translation improvement via remote Claude Code (over SSH)
# The container runs `claude` headless on a host where it's logged in
# (subscription OAuth — no API key needed). See docs/plans/llm-improve-translation.md
# LLM_IMPROVE_ENABLED=true
# CLAUDE_SSH_HOST=192.168.1.234
# CLAUDE_SSH_USER=kees
# CLAUDE_SSH_KEY=/app/.ssh/id_ed25519
# CLAUDE_BIN=/home/kees/.local/bin/claude
# CLAUDE_MODEL=haiku

# Future Features (not yet implemented)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key